# HiddenYatra Environment Variables
# NEVER commit .env to version control!

# Generate a strong secret key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-64-char-string

# Admin password — change from default!
ADMIN_PASSWORD=change-me-to-strong-password

# Set to 'production' for deployment
FLASK_ENV=development
FLASK_DEBUG=0

# MySQL Connection
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=hiddenyatra
DB_USER=root
DB_PASSWORD=your_mysql_password

# SMTP (optional — OTP prints to console if not configured)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_app_password
# SMTP_FROM=your_email@gmail.com
