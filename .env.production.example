# ═══════════════════════════════════════════════════════
# HiddenYatra — Production Environment Variables
# NEVER commit this file to version control!
# Copy to .env and fill in all values.
# ═══════════════════════════════════════════════════════

# ── Application Mode ──
FLASK_ENV=production
FLASK_DEBUG=0

# ── Secrets ──
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_TO_64_CHAR_RANDOM_HEX

# Admin panel password — use a strong unique password
ADMIN_PASSWORD=CHANGE_ME_TO_STRONG_PASSWORD

# ── MySQL Database ──
# NEVER use root in production!
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=hiddenyatra
DB_USER=hiddenyatra_app
DB_PASSWORD=CHANGE_ME_TO_DB_PASSWORD
DB_POOL_SIZE=5
DB_POOL_MAX=20
DB_TIMEOUT=10

# ── Gunicorn ──
GUNICORN_WORKERS=4
GUNICORN_THREADS=2
GUNICORN_BIND=0.0.0.0:5000
GUNICORN_LOG_LEVEL=info
FORWARDED_ALLOW_IPS=127.0.0.1

# ── Email / OTP ──
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_specific_password
SMTP_FROM=your_email@gmail.com
